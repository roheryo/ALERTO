{
  "name": "alerto-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "import:ili-2023": "node scripts/import-ili-2023.mjs",
    "import:ili-2023:dry": "node scripts/import-ili-2023.mjs --dry-run",
    "import:dengue": "node scripts/import-dengue-csv.mjs",
    "import:dengue:dry": "node scripts/import-dengue-csv.mjs --dry-run",
    "import:surveillance": "node scripts/import-ili-2023.mjs && node scripts/import-dengue-csv.mjs",
    "seed:jun2026-week": "node scripts/generate-jun2026-week-cases.mjs --purge",
    "seed:jun2026-week:dry": "node scripts/generate-jun2026-week-cases.mjs --dry-run",
    "evaluate:alerts": "node jobs/evaluateAlerts.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5"
  }
