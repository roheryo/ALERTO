# Weather (optional — OpenWeatherMap; falls back to Open-Meteo if unset or on error)
OPENWEATHER_API_KEY=
# Cache weather responses per coordinate (milliseconds, default 600000 = 10 min)
WEATHER_CACHE_TTL_MS=600000

# LSTM inference service (FastAPI at ml/serve/main.py)
# Start with: cd ml && .\.venv\Scripts\activate && uvicorn serve.main:app --port 5050
# Note: Windows may already use :5000 for the local "AI Foundry" service; we
# default to :5050 to avoid clashes.
ML_SERVICE_URL=http://127.0.0.1:5050
ML_TIMEOUT_MS=8000
