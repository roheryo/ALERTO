{
  "name": "alerto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes kill-port 3001 5050 && concurrently -n api,web,ml -c cyan,green,magenta -k \"npm run dev --prefix backend\" \"vite\" \"npm run ml:serve\"",
    "dev:no-ml": "npx --yes kill-port 3001 && concurrently -n api,web -c cyan,green -k \"npm run dev --prefix backend\" \"vite\"",
    "dev:client": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test src/lib/**/*.test.js",
    "preview": "vite preview",
    "ml:serve": "cd ml && .venv\\Scripts\\python.exe -m uvicorn serve.main:app --host 127.0.0.1 --port 5050",
    "ml:train": "ml\\.venv\\Scripts\\python.exe ml/train.py --disease all",
    "ml:retrain": "ml\\.venv\\Scripts\\python.exe ml/retrain.py --disease all",
    "ml:retrain:reuse": "ml\\.venv\\Scripts\\python.exe ml/retrain.py --disease all --skip-build",
    "ml:schedule": "ml\\.venv\\Scripts\\python.exe ml/scheduler.py --day mon --time 02:00",
    "ml:eval": "ml\\.venv\\Scripts\\python.exe ml/evaluate_baselines.py --disease all && ml\\.venv\\Scripts\\python.exe scripts/show-baselines.py",
    "ml:fetch-weather": "node backend/scripts/fetch-weather-history.mjs",
    "ml:build-dataset": "node backend/scripts/build-ml-datasets.mjs",
    "ml:build-dataset:imported": "node backend/scripts/build-ml-datasets.mjs --include-imported",
    "ml:synth": "node backend/scripts/generate-synthetic-cases.mjs",
    "ml:synth:dry": "node backend/scripts/generate-synthetic-cases.mjs --dry-run",
    "ml:synth:reset": "node backend/scripts/generate-synthetic-cases.mjs --purge",
    "ml:rebuild": "npm run ml:fetch-weather && npm run ml:build-dataset && npm run ml:train && npm run ml:eval",
    "ml:rebuild:imported": "npm run ml:fetch-weather && npm run ml:build-dataset:imported && npm run ml:train && npm run ml:eval",
    "ml:rebuild:synthetic": "npm run ml:fetch-weather && npm run ml:synth:reset && npm run ml:build-dataset && npm run ml:train && npm run ml:eval",
    "start": "npm run start:synthetic",
    "start:synthetic": "npm run ml:synth:reset && npm run ml:build-dataset && npm run ml:train && npm run dev",
    "start:fresh": "npm run ml:fetch-weather && npm run ml:synth:reset && npm run ml:build-dataset && npm run ml:train && npm run dev",
    "start:fast": "npm run dev",
    "ml:health": "node -e \"fetch('http://127.0.0.1:5050/health').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2))).catch(e=>{console.error('ML service DOWN:',e.message);process.exit(1)})\""
  },
  "dependencies": {
    "apexcharts": "^5.11.0",
    "lucide-react": "^1.11.0",
    "react": "^19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.1"
  }
}
