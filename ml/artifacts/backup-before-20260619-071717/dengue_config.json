{
  "feature_columns": [
    "case_count",
    "cases_lag_1",
    "cases_lag_2",
    "cases_rolling_4wk",
    "cases_rolling_8wk",
    "barangay_count_reporting",
    "week_sin",
    "week_cos",
    "month",
    "temp_mean_c",
    "humidity_mean_pct",
    "rainfall_sum_mm",
    "rainfall_sum_mm_lag_4",
    "rainfall_sum_mm_lag_6",
    "rainfall_sum_mm_lag_8",
    "pct_stagnant_water_4wk",
    "pct_recent_heavy_rain_4wk",
    "pct_flood_history_4wk"
  ],
  "target_columns": [
    "cases_t_plus_1",
    "cases_t_plus_2",
    "cases_t_plus_3",
    "cases_t_plus_4"
  ],
  "lookback_weeks": 20,
  "horizon_weeks": 4,
  "target_transform": "log1p",
  "hidden": 128,
  "dropout": 0.25,
  "weight_decay": 0.0001,
  "learning_rate": 0.0005,
  "grad_clip_norm": 1.0,
  "lr_scheduler_enabled": true,
  "scaling": "global",
  "loss_type": "weighted_mse"
}