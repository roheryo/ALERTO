# Dependencies (root + backend/)
node_modules/

# Vite / frontend build output
dist/
dist-ssr/
build/

# Vite dev cache
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets (never commit real keys or DB passwords)
.env
.env.*
!.env.example
!**/.env.example

# Local overrides (Vite, editors)
*.local

# Test / lint caches
coverage/
.nyc_output/
.eslintcache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Certificates / private keys (if generated locally)
*.pem
*.key
*.p12
*.pfx

# Optional: local DB dumps (keep database/*.sql migrations in git)
*-dump.sql
*.sql.backup

# ML retraining runtime outputs (versioned model bundles + audit trail)
ml/.venv/
ml/artifacts/versions/
ml/artifacts/retrain_log.jsonl
ml/artifacts/active_version.json
ml/artifacts/cron.log
